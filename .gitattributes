# Normalize line endings to LF in the repository and working tree so that
# `dart format --set-exit-if-changed` behaves the same on every machine.
* text=auto eol=lf

# Windows scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.pdf binary
